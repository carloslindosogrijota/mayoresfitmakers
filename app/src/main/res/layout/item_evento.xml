<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_senderismo_card"
        android:elevation="8dp"
        android:padding="12dp"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/imgEvento"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:scaleType="centerCrop"
            android:contentDescription="@string/senderismo_image"
            android:src="@drawable/ic_launcher_foreground" />

        <TextView
            android:id="@+id/txtTipo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tipo"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="10dp" />

        <TextView
            android:id="@+id/txtLugar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Lugar"
            android:textSize="16sp"
            android:layout_marginTop="4dp" />

        <!-- NUEVO: Fecha (opcional pero recomendable) -->
        <TextView
            android:id="@+id/txtFecha"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Fecha"
            android:textSize="14sp"
            android:layout_marginTop="4dp" />

        <!-- NUEVO: Plazas / Inscritos -->
        <TextView
            android:id="@+id/txtPlazas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="0 / 0 plazas"
            android:textSize="14sp"
            android:layout_marginTop="4dp" />

    </LinearLayout>

</FrameLayout>
